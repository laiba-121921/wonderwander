  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa": "playwright test -c playwright.pwa.config.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "eval": "tsx content/tooling/eval-prompts.ts",
    "lint": "eslint . && tsx scripts/check-dashes.ts && tsx scripts/check-secrets.ts && tsx scripts/check-curriculum.ts",
    "fingerprints": "tsx scripts/curriculum-fingerprints.ts",
    "content": "tsx scripts/parse-content.ts",
    "texts": "tsx scripts/fetch-texts.ts",
    "setup": "tsx scripts/setup.ts",
    "pack": "tsx scripts/build-pack.ts",
    "upload-pack": "tsx scripts/upload-pack.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "date-fns": "^4.4.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "remark-gfm": "^4.0.1",
